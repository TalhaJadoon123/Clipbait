# Clipbait autopilot as a systemd user service.
#
# Keeps one autopilot pinned to a named streamer's current live room and, with
# --live, posts each clip to the connected Postiz channel the moment it renders.
#
# Install (user scope, no root):
#   mkdir -p ~/.config/systemd/user
#   cp docs/clipbait-autopilot.service ~/.config/systemd/user/
#   $EDITOR ~/.config/systemd/user/clipbait-autopilot.service   # set the match + flags
#   systemctl --user daemon-reload
#   systemctl --user enable --now clipbait-autopilot.service
#   journalctl --user -u clipbait-autopilot.service -f
#
# %h expands to the invoking user's home directory. Adjust WorkingDirectory and
# the two paths below if the checkout lives somewhere else.

[Unit]
Description=Clipbait autopilot - clip a streamer's live room and post Shorts
Documentation=https://github.com/TalhaJadoon123/Clipbait
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Repos/Clipbait
Environment=PYTHONUNBUFFERED=1
# Thresholds are tuned for a busy GTA 6 stream: the on-stream detector must be
# allowed to fire (content-threshold ~1.3), and min-score must admit the median
# clip. The stock 3.0 / 2.5 / 35 were tuned for a quiet room and clip nothing
# here. --now posts immediately; the round-end publish remains as a retry.
ExecStart=%h/Repos/Clipbait/.venv/bin/python %h/Repos/Clipbait/scripts/supervise_live.py \
  --match "kai cenat" \
  --query "gta 6" \
  --platform shorts \
  --live \
  --now \
  --minutes 30 \
  --threshold 2.0 \
  --content-threshold 1.3 \
  --min-score 20 \
  --max-clips 6 \
  --hashtags "#kaicenat #gta6 #shorts"
Restart=always
RestartSec=30
Nice=5
TimeoutStopSec=60

[Install]
WantedBy=default.target