# Clipbait configuration
# Copy to `.env` (git-ignored). Every value here is optional: the zero-key
# path renders clips with local/existing tooling and heuristic ranking.
# Values already present in the environment take precedence over this file.

# ---------------------------------------------------------------- storage ---
# Where projects, live buffers, models and the SQLite database live.
# Defaults to ./data inside the repo, else ~/.clipbait.
# CLIPBAIT_DATA_DIR=./data
# CLIPBAIT_DB_PATH=./data/clipbait.db

# ------------------------------------------------------------------ serve ---
# CLIPBAIT_HOST=127.0.0.1
# CLIPBAIT_PORT=8000
# CLIPBAIT_CORS_ORIGINS=*
# CLIPBAIT_PUBLIC_BASE_URL=http://localhost:8000
# CLIPBAIT_WEB_DIST=./apps/web/dist

# ----------------------------------------------------------- binaries/paths -
# CLIPBAIT_FFMPEG=ffmpeg
# CLIPBAIT_FFPROBE=ffprobe
# CLIPBAIT_YTDLP=yt-dlp

# ---------------------------------------------------------- transcription ---
# auto | whisper | openai | gemini | mock
# CLIPBAIT_TRANSCRIBER=auto
# CLIPBAIT_WHISPER_MODEL=small
# CLIPBAIT_WHISPER_DEVICE=auto
# CLIPBAIT_WHISPER_COMPUTE=int8

# ---------------------------------------------------------------- ranking ---
# auto | openai | anthropic | gemini | ollama | none
# CLIPBAIT_LLM_PROVIDER=auto
# CLIPBAIT_OPENAI_MODEL=gpt-4o-mini
# CLIPBAIT_ANTHROPIC_MODEL=claude-sonnet-4-2
# CLIPBAIT_GEMINI_MODEL=gemini-2.5-flash
# CLIPBAIT_OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud keys. Leave empty to stay fully local.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ------------------------------------------------------------- rendering ---
# CLIPBAIT_MAX_CLIPS=8
# CLIPBAIT_TARGET_CLIP_SECONDS=55
# CLIPBAIT_RENDER_CONCURRENCY=1
# auto | cpu | nvenc | qsv | vaapi | videotoolbox
# CLIPBAIT_HW_ENCODER=auto
# Drop clips that sit on an ad break, a "be right back" slate or a frozen
# screen. Off by default: a stream that is meant to be still would lose its
# clips. One ffmpeg pass per source measures it.
# CLIPBAIT_SKIP_STATIC=0
# CLIPBAIT_STATIC_THRESHOLD=0.4
# CLIPBAIT_STATIC_MIN_SECONDS=6

# ------------------------------------------------------------ meme inserts ---
# Short b-roll cutaways inside a clip, only where the transcript has a dead-air
# gap or a strong signal. The insert is muted, so the spoken audio (and its
# word-synced captions) keep running underneath and never drift.
# auto = use a meme library or generation API when configured, else the locally
# rendered placeholder. `fixture` forces the offline path, `none` disables it.
# auto | search | api | fixture | none
# CLIPBAIT_MEME_PROVIDER=auto
# Searchable meme library (Giphy, Tenor, your own catalogue). See docs/MEMES.md.
# Giphy recipe: key from https://developers.giphy.com/dashboard (create an app,
# choose the API). Video path lists resolutions best-first, so an HD result wins
# and anything smaller still contributes a candidate.
#   CLIPBAIT_MEME_PROVIDER=search
#   CLIPBAIT_MEME_SEARCH_URL=https://api.giphy.com/v1/gifs/search
#   CLIPBAIT_MEME_SEARCH_KEY=<your key>
#   CLIPBAIT_MEME_SEARCH_AUTH=query
#   CLIPBAIT_MEME_SEARCH_RESULTS=data
#   CLIPBAIT_MEME_SEARCH_VIDEO=images.hd.mp4,images.original.mp4
#   CLIPBAIT_MEME_SEARCH_RATING=pg-13
# CLIPBAIT_MEME_SEARCH_URL=
# CLIPBAIT_MEME_SEARCH_KEY=
# bearer | header | query | none
# CLIPBAIT_MEME_SEARCH_AUTH=bearer
# CLIPBAIT_MEME_SEARCH_HEADER=Authorization
# CLIPBAIT_MEME_SEARCH_KEY_PARAM=api_key
# CLIPBAIT_MEME_SEARCH_QUERY_PARAM=q
# Dot paths into the JSON response.
# CLIPBAIT_MEME_SEARCH_RESULTS=results
# CLIPBAIT_MEME_SEARCH_VIDEO=url
# CLIPBAIT_MEME_SEARCH_LIMIT=8
# CLIPBAIT_MEME_SEARCH_RATING=
# Hosted text-to-video endpoint. Receives {prompt,duration,aspect_ratio,width,
# height,fps} and returns a video URL, or an id that is polled at <url>/<id>.
# CLIPBAIT_MEME_API_URL=
# CLIPBAIT_MEME_API_KEY=
# CLIPBAIT_MEME_MODEL=
# CLIPBAIT_MEME_POLL_SECONDS=240

# ------------------------------------------------------------------- live ---
# CLIPBAIT_LIVE_BUFFER_SECONDS=180
# CLIPBAIT_LIVE_SEGMENT_SECONDS=4
# auto | pytchat | innertube | api | demo
# CLIPBAIT_LIVE_CHAT_PROVIDER=auto
# Optional polling fallback for YouTube live chat.
# YOUTUBE_API_KEY=

# On-stream content detection is per-monitor (MonitorOptions), not env-driven:
# content_detection=true, content_threshold=2.5, content_interval=18s,
# speech_window=32s. Speech scoring is skipped automatically when the resolved
# transcriber is `mock`; loudness and action still run.

# -------------------------------------------------------------- publishing -
# Post clips to your own accounts through Upload-Post, at the best window.
# Without a key, `clipbait publish` is a dry run: it prints the plan and sends
# nothing. UPLOAD_POST_USER is the profile whose accounts you connected.
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_USER=
# CLIPBAIT_UPLOAD_POST_URL=https://api.upload-post.com
# Seconds before a slow upload is abandoned; raise it on a low-bandwidth link.
# CLIPBAIT_UPLOAD_POST_TIMEOUT=300
#
# --- Self-hosted Postiz (unmetered, no per-upload limit) -------------------
# Set the provider to `postiz` to send through your own Postiz install instead
# of the metered Upload-Post API. Upload-Post vars are then ignored. Create the
# key in Postiz under Settings > API.
# CLIPBAIT_PUBLISH_PROVIDER=upload_post   # upload_post | postiz
# POSTIZ_API_KEY=
# CLIPBAIT_POSTIZ_API_URL=http://localhost:4007/api/public/v1

# --------------------------------------------------------------- security ---
# Disables the SSRF guard so LAN/localhost URLs can be ingested.
# Only enable on a trusted private network.
# CLIPBAIT_ALLOW_PRIVATE_URLS=0

# -------------------------------------------------------------- telemetry ---
# Reserved. Clipbait never phones home; 0 is the only implemented state.
# CLIPBAIT_TELEMETRY=0